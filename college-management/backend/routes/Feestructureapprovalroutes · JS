// routes/feeStructureApprovalRoutes.js
 
const express = require('express');
const router  = express.Router();
const ctrl    = require('../controllers/feeStructureApprovalController');
const { protect, authorizeRoles } = require('../middleware/authMiddleware');
 
// Accounts — submit request
router.post(  '/submit',           protect, authorizeRoles('staff_accounts'), ctrl.submitApproval);
 
// All roles can get list (with optional ?myOnly=true for accounts)
router.get(   '/all',              protect, ctrl.getAll);
 
// Counts badge
router.get(   '/pending-counts',   protect, ctrl.getPendingCounts);
 
// Principal actions
router.put(   '/principal/approve/:id', protect, authorizeRoles('staff_principal'), ctrl.principalApprove);
router.put(   '/principal/reject/:id',  protect, authorizeRoles('staff_principal'), ctrl.principalReject);
 
// Admin actions
router.put(   '/admin/approve/:id', protect, authorizeRoles('admin'), ctrl.adminApprove);
router.put(   '/admin/reject/:id',  protect, authorizeRoles('admin'), ctrl.adminReject);
 
module.exports = router;
 
