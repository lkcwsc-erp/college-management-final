/* fixScholarshipIndex.js — run ONCE then delete */
require('dotenv').config();
const mongoose = require('mongoose');

async function fix() {
  await mongoose.connect(process.env.MONGO_URI);
  const col = mongoose.connection.db.collection('scholarshipmasters');

  // Show all indexes before
  console.log('\n--- BEFORE ---');
  const before = await col.indexes();
  before.forEach(i => console.log(i.name, i.unique ? '⚠️ UNIQUE' : '✅'));

  // Drop ALL indexes except _id (safest — mongoose recreates correct ones on restart)
  await col.dropIndexes();
  console.log('\n🗑️  All indexes dropped');

  // Show after
  console.log('\n--- AFTER ---');
  const after = await col.indexes();
  after.forEach(i => console.log(i.name, i.unique ? '⚠️ UNIQUE' : '✅'));

  await mongoose.disconnect();
  console.log('\n✅ Done — restart your server now');
}

fix().catch(console.error);
